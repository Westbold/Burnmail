{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "temp-mail",
	"account_id": "71f5759e26857110109f0877de8ab0ad",
	"main": "src/index.ts",
	"compatibility_date": "2025-07-15",
	"workers_dev": true,
	"preview_urls": false,
	"observability": {
		"enabled": true
	},
	"d1_databases": [
		{
			"binding": "D1",
			"database_name": "temp-mail-d1",
			"database_id": "ba7290ed-c10d-4548-940a-566d279d6859"
		}
	],
	"triggers": {
		"crons": [
			"0 */2 * * *"
		]
	},
	"vars": {
		"TELEGRAM_LOG_ENABLE": false,
		"HOURS_TO_DELETE_D1": 3
	},
	"placement": {
		"mode": "smart"
	}
}
